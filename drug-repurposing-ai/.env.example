# Application
APP_NAME=Drug Repurposing AI
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production

# Server
HOST=0.0.0.0
PORT=8000

# File Upload
MAX_UPLOAD_SIZE_MB=20
UPLOAD_DIR=data/uploads

# Tesseract OCR
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Knowledge Graph
KG_PATH=data/processed/knowledge_graph.gpickle

# Model
MODEL_DIR=models

# Fusion Weights
ALPHA=0.6
BETA=0.4

# Database (future)
# DATABASE_URL=sqlite:///./data/app.db
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=password
